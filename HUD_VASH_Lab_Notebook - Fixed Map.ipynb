   "source": [
    "# -------------------------------------------------------------------------\n",
    "# 1. Clean HUD-VASH Administrative Data\n",
    "# -------------------------------------------------------------------------\n",
    "df_hud_clean = (\n",
    "    df_hud\n",
    "    # Fix the classic FIPS leading-zero truncation trap (e.g., '6037' -> '06037')\n",
    "    .withColumn(\"county_fips\", F.lpad(F.trim(F.col(\"county_fips\").cast(\"string\")), 5, \"0\"))\n",
    "    # Filter out unallocated rural counties (vouchers_issued == 0) and HUD privacy-masked cells (vouchers_leased == -4)\n",
    "    .filter((F.col(\"vouchers_issued\") > 0) & (F.col(\"vouchers_leased\") >= 0))\n",
    "    # Calculate HUD-VASH Voucher Utilization Rate (%)\n",
    "    .withColumn(\"utilization_rate\", F.round((F.col(\"vouchers_leased\") / F.col(\"vouchers_issued\")) * 100.0, 2))\n",
    ")\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# 2. Clean U.S. Census ACS Demographic & Housing Market Data\n",
    "# -------------------------------------------------------------------------\n",
    "df_pums_clean = (\n",
    "    df_pums\n",
    "    .withColumn(\"county_fips\", F.lpad(F.trim(F.col(\"county_fips\").cast(\"string\")), 5, \"0\"))\n",
    "    # Filter out Census Bureau sentinel codes (-666666666) and zero denominators\n",
    "    .filter(\n",
    "        (F.col(\"B25064_001E\") > 0) &\n",
    "        (F.col(\"B17001_001E\") > 0) &\n",
    "        (F.col(\"B21001_001E\") > 0) &\n",
    "        (F.col(\"B25002_001E\") > 0) &\n",
    "        (F.col(\"B25003_001E\") > 0)\n",
    "    )\n",
    "    # Engineer Socioeconomic & Housing Market Control Variables\n",
    "    .withColumn(\"median_rent\", F.col(\"B25064_001E\").cast(\"double\"))\n",
    "    .withColumn(\"poverty_rate\", F.round((F.col(\"B17001_002E\") / F.col(\"B17001_001E\")) * 100.0, 2))\n",
    "    .withColumn(\"veteran_pop\", F.col(\"B21001_002E\").cast(\"integer\"))\n",
    "    .withColumn(\"veteran_pct\", F.round((F.col(\"B21001_002E\") / F.col(\"B21001_001E\")) * 100.0, 2))\n",
    "    .withColumn(\"vacancy_rate\", F.round((F.col(\"B25002_003E\") / F.col(\"B25002_001E\")) * 100.0, 2))\n",
    "    .withColumn(\"renter_share_pct\", F.round((F.col(\"B25003_003E\") / F.col(\"B25003_001E\")) * 100.0, 2))\n",
    "    .withColumn(\"state_fips\", F.substring(F.col(\"county_fips\"), 1, 2))\n",
    "    .select(\n",
    "        \"county_fips\", \"state_fips\", \"median_rent\", \"poverty_rate\",\n",
    "        \"veteran_pop\", \"veteran_pct\", \"vacancy_rate\", \"renter_share_pct\"\n",
    "    )\n",
    ")\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# 3. Clean PRRAC Source of Income Law Lookup Table\n",
    "# -------------------------------------------------------------------------\n",
    "df_soi_clean = (\n",
    "    df_soi_laws\n",
    "    .withColumn(\"county_fips\", F.lpad(F.trim(F.col(\"county_fips\").cast(\"string\")), 5, \"0\"))\n",
    "    .select(\"county_fips\", \"has_soi_law\", \"soi_jurisdiction_type\", \"year_enacted\")\n",
    ")\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# 4. Perform Distributed Joins (Inner Join ACS Controls + Broadcast Left Join SOI Laws)\n",
    "# -------------------------------------------------------------------------\n",
    "df_joined = (\n",
    "    df_hud_clean\n",
    "    .join(df_pums_clean, on=\"county_fips\", how=\"inner\")\n",
    "    .join(F.broadcast(df_soi_clean), on=\"county_fips\", how=\"left\")\n",
    "    .fillna({\n",
    "        \"has_soi_law\": 0,\n",
    "        \"soi_jurisdiction_type\": \"No SOI Protection\",\n",
    "        \"year_enacted\": 0\n",
    "    })\n",
    "    # Calculate Unutilized Vouchers (Veterans waiting for housing placement)\n",
    "    .withColumn(\"unutilized_vouchers\", F.col(\"vouchers_issued\") - F.col(\"vouchers_leased\"))\n",
    ")\n",
    "\n",
    "print(\"✅ Phase 2 Complete: Data cleaned, standardized, and joined via Broadcast Hash Join.\")\n",
    "display(df_joined.orderBy(F.desc(\"vouchers_issued\")).limit(10))"
   ]
  },
