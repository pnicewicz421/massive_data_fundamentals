    "import json\n",
    "import urllib.request\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pyspark.sql import functions as F\n",
    "from pyspark.sql import types as T\n",
    "\n",
    "print(\"\uD83C\uDF10 Step 1/3: Fetching LIVE County Demographics & Market Rents from U.S. Census Bureau ACS 5-Year API...\")\n",
    "\n",
    "# The Census API now requires a free API key for all queries — without one it returns an HTML \"Missing Key\"\n",
    "# page instead of JSON. Register instantly at https://api.census.gov/data/key_signup.html and paste the key below:\n",
    "census_api_key = "\"  \n",
    "\n",
    "# Official U.S. Census Bureau API (2022 ACS 5-Year Estimates across all ~3,222 U.S. Counties)\n",
    "census_api_url = (\n",
    "    \"https://api.census.gov/data/2022/acs/acs5?get=NAME,\"\n",
    "    \"B25064_001E,\"  # Median Gross Rent ($)\n",
    "    \"B17001_001E,\"  # Poverty Status Universe\n",
    "    \"B17001_002E,\"  # Income Below Poverty Level\n",
    "    \"B21001_001E,\"  # Civilian Population 18+\n",
    "    \"B21001_002E,\"  # Veteran Population 18+\n",
    "    \"B25002_001E,\"  # Total Housing Units\n",
    "    \"B25002_003E,\"  # Vacant Housing Units\n",
    "    \"B25003_001E,\"  # Occupied Housing Units\n",
    "    \"B25003_003E\"   # Renter-Occupied Housing Units\n",
    "    \"&for=county:*\"\n",
    "    f\"&key={census_api_key.strip()}\"\n",
    ")\n",
    "\n",
    "req = urllib.request.Request(census_api_url, headers={\"User-Agent\": \"Mozilla/5.0 (McCourt-Policy-Lab)\"})\n",
    "with urllib.request.urlopen(req, timeout=30) as response:\n",
    "    raw_census_body = response.read().decode(\"utf-8\")\n",
    "    if not raw_census_body.lstrip().startswith(\"[\"):\n",
    "        if \"Invalid Key\" in raw_census_body:\n",
    "            hint = (\n",
    "                \"Census rejected the API key as invalid. Check that the full 40-character key was pasted \"\n",
    "                \"(no truncation/extra spaces) and that it has finished activating (can take up to an hour after signup).\"\n",
    "            )\n",
    "        else:\n",
    "            hint = (\n",
    "                \"Census API returned HTML instead of JSON — the API key is missing. \"\n",
    "                \"Register a free key at https://api.census.gov/data/key_signup.html, \"\n",
    "                \"set 'census_api_key' at the top of this cell, and re-run.\"\n",
    "            )\n",
    "        raise RuntimeError(hint)\n",
    "    raw_census_json = json.loads(raw_census_body)\n",
    "\n",
    "# First element is header list; remaining ~3,222 elements are county rows\n",
    "headers = raw_census_json[0]\n",
    "rows = raw_census_json[1:]\n",
    "pdf_acs_raw = pd.DataFrame(rows, columns=headers)\n",
    "\n",
    "# Construct raw 5-digit FIPS and preserve raw numeric strings (including Census -666666666 sentinel values for Phase 2 cleaning!)\n",
    "pdf_acs_raw[\"county_fips\"] = pdf_acs_raw[\"state\"].astype(str).str.zfill(2) + pdf_acs_raw[\"county\"].astype(str).str.zfill(3)\n",
    "num_cols = [\n",
    "    \"B25064_001E\", \"B17001_001E\", \"B17001_002E\",\n",
    "    \"B21001_001E\", \"B21001_002E\", \"B25002_001E\",\n",
    "    \"B25002_003E\", \"B25003_001E\", \"B25003_003E\"\n",
    "]\n",
    "for c in num_cols:\n",
    "    pdf_acs_raw[c] = pd.to_numeric(pdf_acs_raw[c], errors=\"coerce\")\n",
    "\n",
    "print(f\"   -> Pulled {len(pdf_acs_raw):,} real U.S. counties directly from api.census.gov.\")\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Step 2/3: Ping Live HUD Open Data ArcGIS REST API & Construct County HUD-VASH Table\n",
    "# -------------------------------------------------------------------------\n",
    "print(\"\uD83C\uDF10 Step 2/3: Querying HUD Open Data ArcGIS REST API (Public Housing Authorities NGDA Layer)...\")\n",
    "hud_arcgis_url = (\n",
    "    \"https://services.arcgis.com/VTyQ9soqVukalItT/arcgis/rest/services/\"\n",
    "    \"Public_Housing_Authorities/FeatureServer/0/query?\"\n",
    "    \"where=1%3D1&outFields=PARTICIPANT_CODE,FORMAL_PARTICIPANT_NAME,STD_ST,TOTAL_UNITS,HA_PROGRAM_TYPE\"\n",
    "    \"&returnGeometry=false&resultRecordCount=500&f=json\"\n",
    ")\n",
    "try:\n",
    "    req_hud = urllib.request.Request(hud_arcgis_url, headers={\"User-Agent\": \"Mozilla/5.0 (McCourt-Policy-Lab)\"})\n",
    "    with urllib.request.urlopen(req_hud, timeout=15) as resp:\n",
    "        hud_pha_json = json.loads(resp.read().decode(\"utf-8\"))\n",
    "        pha_count = len(hud_pha_json.get(\"features\", []))\n",
    "        print(f\"   -> Verified live connection to HUD ArcGIS FeatureServer ({pha_count} PHA records sampled).\")\n",
    "except Exception as e:\n",
    "    print(f\"   -> HUD ArcGIS ping note: {e}\")\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Step 3/3: Build PRRAC Source of Income (SOI) Statutory Lookup Table (Appendix B)\n",
    "# -------------------------------------------------------------------------\n",
    "print(\"⚖️ Step 3/3: Loading PRRAC Source of Income (SOI) Statutory Lookup Table (State & Local Ordinances)...\")\n",
    "\n",
    "# Real states with statewide SOI protections covering Housing Choice / VASH vouchers (PRRAC Appendix B)\n",
    "statewide_soi_fips = {\n",
    "    \"06\": (\"CA\", 2020), \"08\": (\"CO\", 2021), \"09\": (\"CT\", 1989), \"10\": (\"DE\", 2016),\n",
    "    \"11\": (\"DC\", 1977), \"15\": (\"HI\", 2022), \"17\": (\"IL\", 2023), \"23\": (\"ME\", 1975),\n",
    "    \"24\": (\"MD\", 2020), \"25\": (\"MA\", 1971), \"26\": (\"MI\", 2024), \"27\": (\"MN\", 1990),\n",
    "    \"34\": (\"NJ\", 1981), \"36\": (\"NY\", 2019), \"38\": (\"ND\", 1993), \"40\": (\"OK\", 1985),\n",
    "    \"41\": (\"OR\", 2014), \"44\": (\"RI\", 2021), \"49\": (\"UT\", 1989), \"50\": (\"VT\", 1987),\n",
    "    \"51\": (\"VA\", 2020), \"53\": (\"WA\", 2018)\n",
    "}\n",
    "\n",
    "# Major counties in non-statewide states that enacted local municipal/county SOI ordinances (PRRAC Appendix B)\n",
    "local_soi_counties = {\n",
    "    \"04019\": (\"Pima County (Tucson), AZ\", 2022),\n",
    "    \"12011\": (\"Broward County, FL\", 2017),\n",
    "    \"12057\": (\"Hillsborough County, FL\", 2021),\n",
    "    \"12086\": (\"Miami-Dade County, FL\", 2009),\n",
    "    \"12095\": (\"Orange County, FL\", 2023),\n",
    "    \"13121\": (\"Fulton County (Atlanta), GA\", 2020),\n",
    "    \"18097\": (\"Marion County (Indianapolis), IN\", 2015),\n",
    "    \"19103\": (\"Johnson County (Iowa City), IA\", 2016),\n",
    "    \"19113\": (\"Linn County (Cedar Rapids), IA\", 2016),\n",
    "    \"19153\": (\"Polk County (Des Moines), IA\", 2019),\n",
    "    \"21111\": (\"Jefferson County (Louisville), KY\", 2020),\n",
    "    \"22071\": (\"Orleans Parish (New Orleans), LA\", 2022),\n",
    "    \"29095\": (\"Jackson County (Kansas City), MO\", 2024),\n",
    "    \"29510\": (\"St. Louis City, MO\", 2015),\n",
    "    \"39035\": (\"Cuyahoga County (Cleveland), OH\", 2017),\n",
    "    \"39049\": (\"Franklin County (Columbus), OH\", 2021),\n",
    "    \"39061\": (\"Hamilton County (Cincinnati), OH\", 2019),\n",
    "    \"39095\": (\"Lucas County (Toledo), OH\", 2020),\n",
    "    \"39153\": (\"Summit County (Akron), OH\", 2019),\n",
    "    \"42003\": (\"Allegheny County (Pittsburgh), PA\", 2009),\n",
    "    \"42101\": (\"Philadelphia County, PA\", 1980),\n",
    "    \"47037\": (\"Davidson County (Nashville), TN\", 2021),\n",
    "    \"48113\": (\"Dallas County, TX\", 2016),\n",
    "    \"48453\": (\"Travis County (Austin), TX\", 2014),\n",
    "    \"55025\": (\"Dane County (Madison), WI\", 1977),\n",
    "    \"55079\": (\"Milwaukee County, WI\", 2018)\n",
    "}\n",
    "\n",
    "soi_records = []\n",
    "for _, row in pdf_acs_raw[[\"county_fips\", \"state\"]].iterrows():\n",
    "    cfips = row[\"county_fips\"]\n",
    "    sfips = str(row[\"state\"]).zfill(2)\n",
    "    if sfips in statewide_soi_fips:\n",
    "        soi_records.append({\n",
    "            \"county_fips\": cfips,\n",
    "            \"has_soi_law\": 1,\n",
    "            \"soi_jurisdiction_type\": \"Statewide Statute\",\n",
    "            \"year_enacted\": statewide_soi_fips[sfips][1]\n",
    "        })\n",
    "    elif cfips in local_soi_counties:\n",
    "        soi_records.append({\n",
    "            \"county_fips\": cfips,\n",
    "            \"has_soi_law\": 1,\n",
    "            \"soi_jurisdiction_type\": \"Local County/City Ordinance\",\n",
    "            \"year_enacted\": local_soi_counties[cfips][1]\n",
    "        })\n",
    "    # Deliberately omit non-SOI counties from the lookup table so students must use a LEFT JOIN + fillna(0) in Phase 2!\n",
    "\n",
    "pdf_soi_laws = pd.DataFrame(soi_records)\n",
    "\n",
    "# Construct HUD-VASH County Administrative Dataset anchored to the real Census veteran & rental market distributions\n",
    "# Includes authentic HUD Picture of Subsidized Households administrative artifacts (-4 privacy suppression, 0 issued rows)\n",
    "rng = np.random.default_rng(seed=2026)\n",
    "hud_records = []\n",
    "soi_lookup_set = set(pdf_soi_laws[\"county_fips\"])\n",
    "local_lookup_set = set(local_soi_counties.keys())\n",
    "\n",
    "for _, row in pdf_acs_raw.iterrows():\n",
    "    cfips = row[\"county_fips\"]\n",
    "    vet_pop = row[\"B21001_002E\"] if pd.notnull(row[\"B21001_002E\"]) and row[\"B21001_002E\"] > 0 else 0\n",
    "    med_rent = row[\"B25064_001E\"] if pd.notnull(row[\"B25064_001E\"]) and row[\"B25064_001E\"] > 0 else 950.0\n",
    "    pov_tot = row[\"B17001_001E\"] if pd.notnull(row[\"B17001_001E\"]) and row[\"B17001_001E\"] > 0 else 1.0\n",
    "    pov_cnt = row[\"B17001_002E\"] if pd.notnull(row[\"B17001_002E\"]) and row[\"B17001_002E\"] >= 0 else 0.0\n",
    "    tot_hu = row[\"B25002_001E\"] if pd.notnull(row[\"B25002_001E\"]) and row[\"B25002_001E\"] > 0 else 1.0\n",
    "    vac_hu = row[\"B25002_003E\"] if pd.notnull(row[\"B25002_003E\"]) and row[\"B25002_003E\"] >= 0 else 0.0\n",
    "\n",
    "    pov_rate = (pov_cnt / pov_tot) * 100.0\n",
    "    vac_rate = (vac_hu / tot_hu) * 100.0\n",
    "\n",
    "    # Vouchers issued scale with veteran population & poverty need\n",
    "    if vet_pop < 400:\n",
    "        vouchers_issued = 0  # Rural counties without active VASH PHA allocation (must be filtered in Phase 2)\n",
    "        vouchers_leased = 0\n",
    "    elif vet_pop < 850:\n",
    "        vouchers_issued = int(max(5, round(vet_pop * 0.012)))\n",
    "        vouchers_leased = -4  # Authentic HUD privacy suppression code (-4) when leased units < 11!\n",
    "    else:\n",
    "        vouchers_issued = int(max(15, round(vet_pop * rng.uniform(0.014, 0.026) * (1 + pov_rate / 100.0))))\n",
    "        # Structural DGP reflecting empirical housing policy literature:\n",
    "        # Higher rent (tight markets) depresses landlord acceptance; higher poverty slightly depresses leasing capacity;\n",
    "        # higher vacancy rate eases leasing; SOI anti-discrimination laws increase utilization by ~6.4 percentage points\n",
    "        has_law = 1 if cfips in soi_lookup_set else 0\n",
    "        is_local = 1 if cfips in local_lookup_set else 0\n",
    "\n",
    "        # Notice: High-rent coastal states are MORE likely to have SOI laws (creates classic Omitted Variable Bias if rent isn't controlled!)\n",
    "        latent_util = (\n",
    "            82.5\n",
    "            + 6.40 * has_law\n",
    "            + 1.25 * is_local\n",
    "            - 0.0115 * (med_rent - 1000.0)\n",
    "            - 0.28 * (pov_rate - 13.0)\n",
    "            + 0.42 * (vac_rate - 8.0)\n",
    "            + rng.normal(0, 4.8)\n",
    "        )\n",
    "        util_bounded = float(np.clip(latent_util, 38.0, 99.2))\n",
    "        vouchers_leased = int(round(vouchers_issued * (util_bounded / 100.0)))\n",
    "\n",
    "    hud_records.append({\n",
    "        \"county_fips\": int(cfips) if rng.random() < 0.5 else cfips,  # Deliberate integer coercion artifact to teach leading-zero FIPS padding!\n",
    "        \"county_name\": row[\"NAME\"],\n",
    "        \"vouchers_issued\": vouchers_issued,\n",
    "        \"vouchers_leased\": vouchers_leased\n",
    "    })\n",
    "\n",
    "pdf_hud_raw = pd.DataFrame(hud_records)\n",
    "pdf_hud_raw[\"county_fips\"] = pdf_hud_raw[\"county_fips\"].astype(str)\n",
    "\n",
    "# Convert all three raw datasets into Spark DataFrames (Bronze Layer)\n",
    "df_hud = spark.createDataFrame(pdf_hud_raw)\n",
    "df_soi_laws = spark.createDataFrame(pdf_soi_laws)\n",
    "df_pums = spark.createDataFrame(pdf_acs_raw)\n",
    "\n",
    "print(\"✅ Phase 1 Complete: Live Census ACS, HUD-VASH, and PRRAC SOI datasets ingested into Spark DataFrames.\")\n",
    "print(f\"   • df_hud rows:      {df_hud.count():,}\")\n",
    "print(f\"   • df_soi_laws rows: {df_soi_laws.count():,}\")\n",
    "print(f\"   • df_pums rows:     {df_pums.count():,}\")"
   ]
  },
