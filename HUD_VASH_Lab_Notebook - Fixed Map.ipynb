   "source": [
    "import statsmodels.formula.api as smf\n",
    "from pyspark.ml import Pipeline\n",
    "from pyspark.ml.feature import VectorAssembler, StandardScaler\n",
    "from pyspark.ml.regression import LinearRegression, RandomForestRegressor\n",
    "from pyspark.ml.evaluation import RegressionEvaluator\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Part A: Econometric Identification (Driver Node via statsmodels with HC3 Robust SEs)\n",
    "# -------------------------------------------------------------------------\n",
    "pdf_analysis = df_analysis.toPandas()\n",
    "\n",
    "# Model 1: Naive Bivariate Specification (Suffers from Omitted Variable Bias due to Rent Confounding)\n",
    "model_naive = smf.ols(\n",
    "    formula=\"utilization_rate ~ has_soi_law\",\n",
    "    data=pdf_analysis\n",
    ").fit(cov_type=\"HC3\")\n",
    "\n",
    "# Model 2: Controlled Multivariate Specification (Isolates Causal Policy Effect)\n",
    "model_controlled = smf.ols(\n",
    "    formula=\"utilization_rate ~ has_soi_law + median_rent + poverty_rate + vacancy_rate + veteran_pct\",\n",
    "    data=pdf_analysis\n",
    ").fit(cov_type=\"HC3\")\n",
    "\n",
    "# Model 3: Disaggregated Statutory Mechanism (Statewide Statute vs. Local County/City Ordinance)\n",
    "model_mechanism = smf.ols(\n",
    "    formula=\"utilization_rate ~ C(soi_jurisdiction_type, Treatment(reference='No SOI Protection')) + median_rent + poverty_rate + vacancy_rate + veteran_pct\",\n",
    "    data=pdf_analysis\n",
    ").fit(cov_type=\"HC3\")\n",
    "\n",
    "print(\"=\" * 88)\n",
    "print(\"\uD83D\uDCCA ECONOMETRIC COMPARISON: NAIVE BIVARIATE vs. CONTROLLED MULTIVARIATE OLS (HC3 ROBUST SE)\")\n",
    "print(\"=\" * 88)\n",
    "print(f\"• Naive OLS Effect of SOI Law (No Controls):      +{model_naive.params['has_soi_law']:.2f} pp (SE: {model_naive.bse['has_soi_law']:.2f}, p = {model_naive.pvalues['has_soi_law']:.4e})\")\n",
    "print(f\"• Controlled OLS Effect of SOI Law (Full Model):  +{model_controlled.params['has_soi_law']:.2f} pp (SE: {model_controlled.bse['has_soi_law']:.2f}, p = {model_controlled.pvalues['has_soi_law']:.4e})\")\n",
    "print(f\"  -> Omitted Variable Bias Corrected:             +{model_controlled.params['has_soi_law'] - model_naive.params['has_soi_law']:.2f} percentage points!\")\n",
    "print(\"-\" * 88)\n",
    "print(model_controlled.summary())\n",
    "\n",
    "# -------------------------------------------------------------------------\n",
    "# Part B: Distributed Machine Learning Pipeline (Worker Nodes via PySpark MLlib)\n",
    "# -------------------------------------------------------------------------\n",
    "feature_cols = [\"has_soi_law\", \"median_rent\", \"poverty_rate\", \"vacancy_rate\", \"veteran_pct\"]\n",
    "\n",
    "assembler = VectorAssembler(inputCols=feature_cols, outputCol=\"raw_features\")\n",
    "scaler = StandardScaler(inputCol=\"raw_features\", outputCol=\"features\", withStd=True, withMean=True)\n",
    "rf_reg = RandomForestRegressor(featuresCol=\"features\", labelCol=\"utilization_rate\", numTrees=100, maxDepth=6, seed=42)\n",
    "\n",
    "pipeline = Pipeline(stages=[assembler, scaler, rf_reg])\n",
    "train_df, test_df = df_analysis.randomSplit([0.8, 0.2], seed=42)\n",
    "\n",
    "pipeline_model = pipeline.fit(train_df)\n",
    "predictions = pipeline_model.transform(test_df)\n",
    "\n",
    "evaluator_rmse = RegressionEvaluator(labelCol=\"utilization_rate\", predictionCol=\"prediction\", metricName=\"rmse\")\n",
    "evaluator_r2 = RegressionEvaluator(labelCol=\"utilization_rate\", predictionCol=\"prediction\", metricName=\"r2\")\n",
    "\n",
    "rf_stage = pipeline_model.stages[-1]\n",
    "importances = list(zip(feature_cols, rf_stage.featureImportances.toArray()))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 88)\n",
    "print(\"\uD83E\uDD16 DISTRIBUTED PYSPARK MLlib: RANDOM FOREST PREDICTIVE RISK MODEL\")\n",
    "print(\"=\" * 88)\n",
    "print(f\"• Out-of-Sample Test RMSE: {evaluator_rmse.evaluate(predictions):.2f} percentage points\")\n",
    "print(f\"• Out-of-Sample Test R²:   {evaluator_r2.evaluate(predictions):.3f}\")\n",
    "print(\"• Distributed Feature Importances (Predictive Triage Drivers):\")\n",
    "for feat, imp in sorted(importances, key=lambda x: x[1], reverse=True):\n",
    "    print(f\"    - {feat:<18}: {imp:.3f}\")"
   ]
