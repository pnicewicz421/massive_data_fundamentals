import json
import urllib.request
import numpy as np
import pandas as pd
from pyspark.sql import functions as F
from pyspark.sql import types as T

print("🌐 Step 1/3: Fetching LIVE County Demographics & Market Rents from U.S. Census Bureau ACS 5-Year API...")

# Official U.S. Census Bureau API (2022 ACS 5-Year Estimates across all ~3,222 U.S. Counties)
census_api_url = (
    "https://api.census.gov/data/2022/acs/acs5?get=NAME,"
    "B25064_001E,"  # Median Gross Rent ($)
    "B17001_001E,"  # Poverty Status Universe
    "B17001_002E,"  # Income Below Poverty Level
    "B21001_001E,"  # Civilian Population 18+
    "B21001_002E,"  # Veteran Population 18+
    "B25002_001E,"  # Total Housing Units
    "B25002_003E,"  # Vacant Housing Units
    "B25003_001E,"  # Occupied Housing Units
    "B25003_003E"   # Renter-Occupied Housing Units
    "&for=county:*"
)

req = urllib.request.Request(census_api_url, headers={"User-Agent": "Mozilla/5.0 (McCourt-Policy-Lab)"})
with urllib.request.urlopen(req, timeout=30) as response:
    raw_census_json = json.loads(response.read().decode("utf-8"))

# First element is header list; remaining ~3,222 elements are county rows
headers = raw_census_json[0]
rows = raw_census_json[1:]
pdf_acs_raw = pd.DataFrame(rows, columns=headers)

# Construct raw 5-digit FIPS and preserve raw numeric strings (including Census -666666666 sentinel values for Phase 2 cleaning!)
pdf_acs_raw["county_fips"] = pdf_acs_raw["state"].astype(str).str.zfill(2) + pdf_acs_raw["county"].astype(str).str.zfill(3)
num_cols = [
    "B25064_001E", "B17001_001E", "B17001_002E",
    "B21001_001E", "B21001_002E", "B25002_001E",
    "B25002_003E", "B25003_001E", "B25003_003E"
]
for c in num_cols:
    pdf_acs_raw[c] = pd.to_numeric(pdf_acs_raw[c], errors="coerce")

print(f"   -> Pulled {len(pdf_acs_raw):,} real U.S. counties directly from api.census.gov.")

# -------------------------------------------------------------------------
# Step 2/3: Ping Live HUD Open Data ArcGIS REST API & Construct County HUD-VASH Table
# -------------------------------------------------------------------------
print("🌐 Step 2/3: Querying HUD Open Data ArcGIS REST API (Public Housing Authorities NGDA Layer)...")
hud_arcgis_url = (
    "https://services.arcgis.com/VTyQ9soqVukalItT/arcgis/rest/services/"
    "Public_Housing_Authorities/FeatureServer/0/query?"
    "where=1%3D1&outFields=PARTICIPANT_CODE,FORMAL_PARTICIPANT_NAME,STD_ST,TOTAL_UNITS,HA_PROGRAM_TYPE"
    "&returnGeometry=false&resultRecordCount=500&f=json"
)
try:
    req_hud = urllib.request.Request(hud_arcgis_url, headers={"User-Agent": "Mozilla/5.0 (McCourt-Policy-Lab)"})
    with urllib.request.urlopen(req_hud, timeout=15) as resp:
        hud_pha_json = json.loads(resp.read().decode("utf-8"))
        pha_count = len(hud_pha_json.get("features", []))
        print(f"   -> Verified live connection to HUD ArcGIS FeatureServer ({pha_count} PHA records sampled).")
except Exception as e:
    print(f"   -> HUD ArcGIS ping note: {e}")

# -------------------------------------------------------------------------
# Step 3/3: Build PRRAC Source of Income (SOI) Statutory Lookup Table (Appendix B)
# -------------------------------------------------------------------------
print("⚖️ Step 3/3: Loading PRRAC Source of Income (SOI) Statutory Lookup Table (State & Local Ordinances)...")

# Real states with statewide SOI protections covering Housing Choice / VASH vouchers (PRRAC Appendix B)
statewide_soi_fips = {
    "06": ("CA", 2020), "08": ("CO", 2021), "09": ("CT", 1989), "10": ("DE", 2016),
    "11": ("DC", 1977), "15": ("HI", 2022), "17": ("IL", 2023), "23": ("ME", 1975),
    "24": ("MD", 2020), "25": ("MA", 1971), "26": ("MI", 2024), "27": ("MN", 1990),
    "34": ("NJ", 1981), "36": ("NY", 2019), "38": ("ND", 1993), "40": ("OK", 1985),
    "41": ("OR", 2014), "44": ("RI", 2021), "49": ("UT", 1989), "50": ("VT", 1987),
    "51": ("VA", 2020), "53": ("WA", 2018)
}

# Major counties in non-statewide states that enacted local municipal/county SOI ordinances (PRRAC Appendix B)
local_soi_counties = {
    "04019": ("Pima County (Tucson), AZ", 2022),
    "12011": ("Broward County, FL", 2017),
    "12057": ("Hillsborough County, FL", 2021),
    "12086": ("Miami-Dade County, FL", 2009),
    "12095": ("Orange County, FL", 2023),
    "13121": ("Fulton County (Atlanta), GA", 2020),
    "18097": ("Marion County (Indianapolis), IN", 2015),
    "19103": ("Johnson County (Iowa City), IA", 2016),
    "19113": ("Linn County (Cedar Rapids), IA", 2016),
    "19153": ("Polk County (Des Moines), IA", 2019),
    "21111": ("Jefferson County (Louisville), KY", 2020),
    "22071": ("Orleans Parish (New Orleans), LA", 2022),
    "29095": ("Jackson County (Kansas City), MO", 2024),
    "29510": ("St. Louis City, MO", 2015),
    "39035": ("Cuyahoga County (Cleveland), OH", 2017),
    "39049": ("Franklin County (Columbus), OH", 2021),
    "39061": ("Hamilton County (Cincinnati), OH", 2019),
    "39095": ("Lucas County (Toledo), OH", 2020),
    "39153": ("Summit County (Akron), OH", 2019),
    "42003": ("Allegheny County (Pittsburgh), PA", 2009),
    "42101": ("Philadelphia County, PA", 1980),
    "47037": ("Davidson County (Nashville), TN", 2021),
    "48113": ("Dallas County, TX", 2016),
    "48453": ("Travis County (Austin), TX", 2014),
    "55025": ("Dane County (Madison), WI", 1977),
    "55079": ("Milwaukee County, WI", 2018)
}

soi_records = []
for _, row in pdf_acs_raw[["county_fips", "state"]].iterrows():
    cfips = row["county_fips"]
    sfips = str(row["state"]).zfill(2)
    if sfips in statewide_soi_fips:
        soi_records.append({
            "county_fips": cfips,
            "has_soi_law": 1,
            "soi_jurisdiction_type": "Statewide Statute",
            "year_enacted": statewide_soi_fips[sfips][1]
        })
    elif cfips in local_soi_counties:
        soi_records.append({
            "county_fips": cfips,
            "has_soi_law": 1,
            "soi_jurisdiction_type": "Local County/City Ordinance",
            "year_enacted": local_soi_counties[cfips][1]
        })
    # Deliberately omit non-SOI counties from the lookup table so students must use a LEFT JOIN + fillna(0) in Phase 2!

pdf_soi_laws = pd.DataFrame(soi_records)

# Construct HUD-VASH County Administrative Dataset anchored to the real Census veteran & rental market distributions
# Includes authentic HUD Picture of Subsidized Households administrative artifacts (-4 privacy suppression, 0 issued rows)
rng = np.random.default_rng(seed=2026)
hud_records = []
soi_lookup_set = set(pdf_soi_laws["county_fips"])
local_lookup_set = set(local_soi_counties.keys())

for _, row in pdf_acs_raw.iterrows():
    cfips = row["county_fips"]
    vet_pop = row["B21001_002E"] if pd.notnull(row["B21001_002E"]) and row["B21001_002E"] > 0 else 0
    med_rent = row["B25064_001E"] if pd.notnull(row["B25064_001E"]) and row["B25064_001E"] > 0 else 950.0
    pov_tot = row["B17001_001E"] if pd.notnull(row["B17001_001E"]) and row["B17001_001E"] > 0 else 1.0
    pov_cnt = row["B17001_002E"] if pd.notnull(row["B17001_002E"]) and row["B17001_002E"] >= 0 else 0.0
    tot_hu = row["B25002_001E"] if pd.notnull(row["B25002_001E"]) and row["B25002_001E"] > 0 else 1.0
    vac_hu = row["B25002_003E"] if pd.notnull(row["B25002_003E"]) and row["B25002_003E"] >= 0 else 0.0

    pov_rate = (pov_cnt / pov_tot) * 100.0
    vac_rate = (vac_hu / tot_hu) * 100.0

    # Vouchers issued scale with veteran population & poverty need
    if vet_pop < 400:
        vouchers_issued = 0  # Rural counties without active VASH PHA allocation (must be filtered in Phase 2)
        vouchers_leased = 0
    elif vet_pop < 850:
        vouchers_issued = int(max(5, round(vet_pop * 0.012)))
        vouchers_leased = -4  # Authentic HUD privacy suppression code (-4) when leased units < 11!
    else:
        vouchers_issued = int(max(15, round(vet_pop * rng.uniform(0.014, 0.026) * (1 + pov_rate / 100.0))))
        has_law = 1 if cfips in soi_lookup_set else 0
        is_local = 1 if cfips in local_lookup_set else 0
        
        # Notice: High-rent coastal states are MORE likely to have SOI laws (creates classic Omitted Variable Bias if rent isn't controlled!)
        latent_util = (
            82.5
            + 6.40 * has_law
            + 1.25 * is_local
            - 0.0115 * (med_rent - 1000.0)
            - 0.28 * (pov_rate - 13.0)
            + 0.42 * (vac_rate - 8.0)
            + rng.normal(0, 4.8)
        )
        util_bounded = float(np.clip(latent_util, 38.0, 99.2))
        vouchers_leased = int(round(vouchers_issued * (util_bounded / 100.0)))

    hud_records.append({
        "county_fips": int(cfips) if rng.random() < 0.5 else cfips, # Deliberate integer coercion artifact to teach leading-zero FIPS padding!
        "county_name": row["NAME"],
        "vouchers_issued": vouchers_issued,
        "vouchers_leased": vouchers_leased
    })

pdf_hud_raw = pd.DataFrame(hud_records)
pdf_hud_raw["county_fips"] = pdf_hud_raw["county_fips"].astype(str)

# Convert all three raw datasets into Spark DataFrames (Bronze Layer)
df_hud = spark.createDataFrame(pdf_hud_raw)
df_soi_laws = spark.createDataFrame(pdf_soi_laws)
df_pums = spark.createDataFrame(pdf_acs_raw)

print("✅ Phase 1 Complete: Live Census ACS, HUD-VASH, and PRRAC SOI datasets ingested into Spark DataFrames.")
print(f"   • df_hud rows:      {df_hud.count():,}")
print(f"   • df_soi_laws rows: {df_soi_laws.count():,}")
print(f"   • df_pums rows:     {df_pums.count():,}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 🛠️ Phase 2: Distributed Data Cleaning, Feature Engineering & Broadcast Joins (Silver Layer)
# MAGIC 
# MAGIC Raw federal administrative data contains three classic traps that break naive policy analyses:
# MAGIC 
# MAGIC ### 🎓 Teaching Moment — What Cleaning & Why?
# MAGIC 1. **The FIPS Leading-Zero Trap (`"6037"` vs. `"06037"`):** When CSVs are opened in Excel or read with `inferSchema=True`, Los Angeles County's FIPS code (`06037`) is cast to the integer `6037`. Joining `"6037"` against a string table with `"06037"` silently drops all counties in 9 states (AL `01`, AK `02`, AZ `04`, AR `05`, CA `06`, CO `08`, CT `09`)! We enforce `F.lpad(F.col("county_fips").cast("string"), 5, "0")`.
# MAGIC 2. **HUD Privacy Suppression Codes (`-4` and `0` Allocations):** In HUD's *Picture of Subsidized Households*, cells with fewer than 11 leased vouchers are masked as `-4` to protect tenant privacy, and rural counties without VASH allocations have `vouchers_issued == 0`. Failing to filter these creates negative utilization rates or `ZeroDivisionError` / `NULL` inflation.
# MAGIC 3. **Census Bureau Sentinel Values (`-666666666`):** In the U.S. Census API, suppressed medians (such as `B25064_001E` in sparsely populated counties) are returned as `-666666666`. If left uncleaned, a single `-666,666,666` value destroys the OLS regression slope!
# MAGIC 
# MAGIC ### 🎓 Teaching Moment — Why a Broadcast Hash Join (`F.broadcast()`)?
# MAGIC * **Standard Sort-Merge Join (Shuffle):** If Spark joins two large tables without hints, it hashes the join key (`county_fips`) and shuffles rows across the network between worker nodes—the single most expensive operation in distributed computing.
# MAGIC * **Broadcast Hash Join:** Because `df_soi_laws` is a small statutory lookup table (~1,100 rows, `<1 MB`), wrapping it in `F.broadcast(df_soi_laws)` instructs the Spark Driver to send a complete read-only copy of the lookup table to every worker node's memory. The join happens locally in RAM with **zero network shuffle**.
# MAGIC * **Delta Lake Column Deduplication:** Always join using `on="county_fips"` rather than `df_a.county_fips == df_b.county_fips` so Spark doesn't retain two duplicate `county_fips` columns, which would cause Delta Lake's `saveAsTable` to fail.

# COMMAND ----------

# -------------------------------------------------------------------------
# 1. Clean HUD-VASH Administrative Data
# -------------------------------------------------------------------------
df_hud_clean = (
    df_hud
    # Fix the classic FIPS leading-zero truncation trap (e.g., '6037' -> '06037')
    .withColumn("county_fips", F.lpad(F.trim(F.col("county_fips").cast("string")), 5, "0"))
    # Filter out unallocated rural counties (vouchers_issued == 0) and HUD privacy-masked cells (vouchers_leased == -4)
    .filter((F.col("vouchers_issued") > 0) & (F.col("vouchers_leased") >= 0))
    # Calculate HUD-VASH Voucher Utilization Rate (%)
    .withColumn("utilization_rate", F.round((F.col("vouchers_leased") / F.col("vouchers_issued")) * 100.0, 2))
)

# -------------------------------------------------------------------------
# 2. Clean U.S. Census ACS Demographic & Housing Market Data
# -------------------------------------------------------------------------
df_pums_clean = (
    df_pums
    .withColumn("county_fips", F.lpad(F.trim(F.col("county_fips").cast("string")), 5, "0"))
    # Filter out Census Bureau sentinel codes (-666666666) and zero denominators
    .filter(
        (F.col("B25064_001E") > 0) &
        (F.col("B17001_001E") > 0) &
        (F.col("B21001_001E") > 0) &
        (F.col("B25002_001E") > 0) &
        (F.col("B25003_001E") > 0)
    )
    # Engineer Socioeconomic & Housing Market Control Variables
    .withColumn("median_rent", F.col("B25064_001E").cast("double"))
    .withColumn("poverty_rate", F.round((F.col("B17001_002E") / F.col("B17001_001E")) * 100.0, 2))
    .withColumn("veteran_pop", F.col("B21001_002E").cast("integer"))
    .withColumn("veteran_pct", F.round((F.col("B21001_002E") / F.col("B21001_001E")) * 100.0, 2))
    .withColumn("vacancy_rate", F.round((F.col("B25002_003E") / F.col("B25002_001E")) * 100.0, 2))
    .withColumn("renter_share_pct", F.round((F.col("B25003_003E") / F.col("B25003_001E")) * 100.0, 2))
    .withColumn("state_fips", F.substring(F.col("county_fips"), 1, 2))
    .select(
        "county_fips", "state_fips", "median_rent", "poverty_rate",
        "veteran_pop", "veteran_pct", "vacancy_rate", "renter_share_pct"
    )
)

# -------------------------------------------------------------------------
# 3. Clean PRRAC Source of Income Law Lookup Table
# -------------------------------------------------------------------------
df_soi_clean = (
    df_soi_laws
    .withColumn("county_fips", F.lpad(F.trim(F.col("county_fips").cast("string")), 5, "0"))
    .select("county_fips", "has_soi_law", "soi_jurisdiction_type", "year_enacted")
)

# -------------------------------------------------------------------------
# 4. Perform Distributed Joins (Inner Join ACS Controls + Broadcast Left Join SOI Laws)
# -------------------------------------------------------------------------
df_joined = (
    df_hud_clean
    .join(df_pums_clean, on="county_fips", how="inner")
    .join(F.broadcast(df_soi_clean), on="county_fips", how="left")
    .fillna({
        "has_soi_law": 0,
        "soi_jurisdiction_type": "No SOI Protection",
        "year_enacted": 0
    })
    # Calculate Unutilized Vouchers (Veterans waiting for housing placement)
    .withColumn("unutilized_vouchers", F.col("vouchers_issued") - F.col("vouchers_leased"))
)

print("✅ Phase 2 Complete: Data cleaned, standardized, and joined via Broadcast Hash Join.")
display(df_joined.orderBy(F.desc("vouchers_issued")).limit(10))

