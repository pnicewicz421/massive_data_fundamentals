# MAGIC 
# MAGIC We use `plotly` and `kaleido` to generate a high-resolution, static PNG of the county-level SOI legal landscape. This ensures the map renders beautifully when this Databricks notebook is exported to PDF or viewed on GitHub.

# COMMAND ----------

import urllib.request
import json
import plotly.express as px

print("🌐 Downloading U.S. county cartographic boundaries (Census TIGER/Line-derived GeoJSON)...")
geojson_url = "https://raw.githubusercontent.com/plotly/datasets/master/geojson-counties-fips.json"
with urllib.request.urlopen(geojson_url) as response:
    counties_geojson = json.loads(response.read().decode())
print("   -> GeoJSON loaded. Rendering static map...")

# Create a mapping dictionary for colors to force Plotly to use specific hex codes for policy regimes
color_discrete_map = {
    "No SOI Protection": "#e74c3c",       # Red
    "Local County/City Ordinance": "#f1c40f", # Yellow
    "Statewide Statute": "#2980b9"        # Blue
}

# Generate the choropleth map
fig_soi = px.choropleth(
    pdf_analysis,
    geojson=counties_geojson,
    locations="county_fips",
    color="soi_jurisdiction_type",
    color_discrete_map=color_discrete_map,
    scope="usa",
    title="⚖️ The Statutory Geography: Source of Income (SOI) Anti-Discrimination Protections",
    labels={"soi_jurisdiction_type": "SOI Legal Regime"}
)

fig_soi.update_layout(
    margin=dict(l=0, r=0, t=40, b=0),
    title_x=0.5,
    title_font_size=16
)

# Crucial Fix: Force Plotly to output a static PNG image via Kaleido instead of an interactive HTML widget.
# This prevents the blank space issue on GitHub and ensures the map prints to PDF correctly.
fig_soi.show(renderer="png", width=1200, height=750)
print("✅ Map rendered as a static PNG.")

